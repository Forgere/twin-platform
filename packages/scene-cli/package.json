{
  "name": "@twin-platform/scene-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": { ".": "./src/index.ts" },
  "bin": { "scene": "./bin/scene.mjs" },
  "files": ["bin", "src"],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "scene": "bun src/cli.ts",
    "build": "bun build ./src/bin.ts --target=node --format=esm --outfile ./bin/scene.mjs",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@twin-platform/plugins-fishing": "workspace:*",
    "@twin-platform/plugin-sdk": "workspace:*",
    "@twin-platform/plugins-logistics": "workspace:*",
    "@twin-platform/scene-audit": "workspace:*",
    "@twin-platform/scene-runner": "workspace:*",
    "@twin-platform/scene-schema": "workspace:*",
    "@twin-platform/scene-spec": "workspace:*",
    "@twin-platform/world-kernel": "workspace:*"
  }
}
