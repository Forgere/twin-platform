{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@twin-platform/*": ["packages/*/src/index.ts"]
    }
  },
  "files": [],
  "exclude": ["**/node_modules", "**/dist"]
}
