{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@twin-platform/plugins-fishing/studio": ["packages/plugins-fishing/studio/index.ts"],
      "@twin-platform/studio-sdk/*": ["packages/studio-sdk/src/*.ts"],
      "@twin-platform/*": ["packages/*/src/index.ts"]
    }
  },
  "files": [],
  "exclude": ["**/node_modules", "**/dist"]
}
