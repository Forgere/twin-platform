# 部署用环境变量（docker compose / k8s secret 来源）。勿提交真实值。

# 服务端监听端口（容器内固定 8787，这里只控制宿主机映射）
SERVER_PORT=8787

# PostgreSQL 连接串（生产用云厂商托管库的外网/内网地址）
# 阿里云 RDS / 腾讯云 TencentDB / 华为云 RDS / PolarDB 任选，格式一致：
DATABASE_URL=postgres://twin_user:strong_password@rm-xxx.rds.aliyuncs.com:5432/twin

# 可选：表前缀 schema（默认 public；建议用独立 schema 隔离）
TWIN_PG_SCHEMA=twin

# API 鉴权共享 token：必须和 apps/worker 的 API_TOKEN 一致（若走 Cloudflare 边缘）。
# 不设 = 不启用鉴权（仅限内网/本地）。
TWIN_API_TOKEN=change-me-to-a-long-random-secret

# 自托管 postgres 服务用（取消注释 docker-compose 里的 postgres 时填）
# PG_USER=postgres
# PG_PASSWORD=change-me
# PG_DB=twin
