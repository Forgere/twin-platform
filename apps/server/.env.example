# Twin Platform 服务端环境变量
#
# 存储后端：file（默认，零依赖单 JSON 文件）或 postgres（需 DATABASE_URL）。
# 不设 TWIN_STORAGE 时，只要设置了 DATABASE_URL 就自动走 postgres。
TWIN_STORAGE=postgres

# PostgreSQL 连接串（postgres 后端必填）。生产务必放到 .env.local，勿提交。
# 格式：postgres://user:password@host:5432/dbname
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/twin

# 零依赖验证用：pglite:// 走 WASM 版真实 PostgreSQL（进程内内存库），不装数据库也能跑。
# 必须显式写这个前缀，不会作为上面 postgres:// 的兜底。
# DATABASE_URL=pglite://memory

# 可选：表前缀 schema（例如 twin）。不设则用 public。
# TWIN_PG_SCHEMA=twin

# 文件后端的数据路径（TWIN_STORAGE=file 时生效）。
# TWIN_DATA=data/twin.json

# 监听端口。
PORT=8787

# API 鉴权：共享 Bearer token。**不设 = 不启用鉴权**（本地零配置照常跑）。
# 设了之后 /api/*（含 /api/health）全部要求 Authorization: Bearer <此值>。
# 生产不要把它编译进前端：由 apps/worker 的 `wrangler secret put API_TOKEN` 注入，
# 两边必须一致，否则上游全 401。
# 本地跨源联调（vite:3000 直连 server）才需要前端配 VITE_TWIN_API_TOKEN。
# TWIN_API_TOKEN=change-me

# 同源托管的 Studio 构建产物目录（开发模式不用管，跑 vite 即可）。
# TWIN_STUDIO_DIST=apps/studio/dist
