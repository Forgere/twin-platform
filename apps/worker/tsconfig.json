{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,

    // Worker 运行时没有 DOM 也没有 Node：只用 WebWorker 这套标准全局，
    // types 置空避免把根 node_modules/@types 里的 node 全局（process 等）拉进来。
    "lib": ["ESNext", "WebWorker"],
    "types": []
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "src/**/*.test.ts"]
}
